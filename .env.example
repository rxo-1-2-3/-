# =========================================================
# 見本ファイルです。実際の値はここに書かず、GitHubの
#   Settings > Secrets and variables > Actions
# に登録してください（README.md 手順4）。
# ローカルで試すときだけ、このファイルを .env にコピーして使います。
# =========================================================

# ---- 方式の切り替え（ここ1か所だけ）----
#   csv  : CSVを書き出してWeb公開し、Zoho Sheetが「データ接続」で取り込む（推奨・簡単）
#   api  : Zoho Sheet APIへ直接1行追記する（リポジトリを非公開にしたい場合）
#   both : 両方
OUTPUT_MODE=csv

# ---- 共通の任意設定（省略可）----
TICKER_SYMBOL=^N225
HISTORY_PERIOD=5y
CSV_PATH=docs/stock_data_cleaned.csv
# 前日比がこの%を超えたら「データ破損の疑い」として停止する
MAX_DAILY_MOVE_PCT=20

# =========================================================
# ここから下は OUTPUT_MODE=api / both のときだけ必要です。
# OUTPUT_MODE=csv のまま使うなら、すべて未設定で構いません。
# =========================================================

ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_REFRESH_TOKEN=1000.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_RESOURCE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_WORKSHEET_NAME=Sheet1

# データセンターに合わせて設定（既定は米国 .com）
#   米国        : https://accounts.zoho.com
#   日本        : https://accounts.zoho.jp        ← .co.jp ではありません
#   欧州        : https://accounts.zoho.eu
#   インド      : https://accounts.zoho.in
#   オーストラリア: https://accounts.zoho.com.au
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://sheet.zoho.com
